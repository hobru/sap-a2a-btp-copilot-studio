# ---------------------------------------------------------------------------
# Example environment for LOCAL development (cds watch).
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is gitignored).
# In Cloud Foundry these are set as app env vars / via mta.yaml instead.
# ---------------------------------------------------------------------------

# Public URL advertised in the served Agent Card (url field). Locally this is
# the cds watch address. In CF this defaults to the module's own route.
A2A_SERVER_URL=http://localhost:4004

# Name of the BTP destination the skills call. On the trial subaccount this is
# `pm4-ssl`. Must match the destination configured in the BTP cockpit.
SAP_DESTINATION_NAME=pm4-ssl

# ---- Local dev auth (mocked IAS) ----
# In development the auth strategy is `mocked` (see package.json). Custom A2A
# routes accept an `x-dev-email` header to simulate the authenticated principal:
#   curl -H "x-dev-email: dev.user@example.com" ...
# No IAS token is required locally. In CF, inbound auth is real IAS (kind: ias).

# ---- Optional Agent Card metadata overrides ----
# A2A_AGENT_NAME=SAP Catalog Agent
# A2A_AGENT_VERSION=0.1.0
# A2A_PROVIDER_ORG=Your Organization
# A2A_PROVIDER_URL=https://example.com
# A2A protocol version advertised on the agent card (default 0.3.0).
# Only change if the consuming client (e.g. Microsoft Copilot Studio) requires a different line.
# A2A 1.0 is a BREAKING change and NOT a drop-in — do not set 1.0 without a 1.0-capable handler.
# A2A_PROTOCOL_VERSION=0.3.0

# ---- Optional: plain-text NLU via Azure OpenAI (option B) ----
# The deterministic parser (option A) is always on. Set ALL THREE of these to
# also enable the Azure OpenAI extraction path; on any failure it falls back to
# option A. Leave unset to stay fully deterministic/offline.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<secret-key-never-commit>
# AZURE_OPENAI_DEPLOYMENT_NAME=<chat-deployment>
# AZURE_OPENAI_API_VERSION=2024-06-01   # optional, this is the default

# ---- Optional: phase-2 principal propagation ----
# Set to `true` only after switching the destination to OnPremise +
# PrincipalPropagation, so the caller's IAS JWT is threaded to the destination
# lookup (see GETTING-STARTED.md Section 8). Leave unset for phase-1 Internet+BasicAuth.
# PRINCIPAL_PROPAGATION=true

# ---------------------------------------------------------------------------
# NOTE: Backend credentials are NEVER placed here. Outbound auth is handled by
# the BTP destination (technical user or principal propagation) + Cloud
# Connector. For local hybrid testing use `cds bind` against a real destination
# service instance rather than hardcoding credentials.
# ---------------------------------------------------------------------------
